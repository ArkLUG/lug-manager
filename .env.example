# Server
LUG_PORT=8080
LUG_DB_PATH=./lug.db
LUG_TEMPLATES_DIR=./src/templates

# Discord Bot (for creating events/threads)
DISCORD_BOT_TOKEN=your_bot_token_here

# Discord OAuth2 App (for user login)
DISCORD_CLIENT_ID=your_oauth2_client_id
DISCORD_CLIENT_SECRET=your_oauth2_client_secret
DISCORD_REDIRECT_URI=http://localhost:8080/auth/callback

# Discord Interactions (Ed25519-verified endpoint for resolving member matches via button/modal).
# Public Key and Application ID are both on the Developer Portal's General Information page -
# Public Key is NOT the bot token or OAuth2 client secret. Set the Developer Portal's
# "Interactions Endpoint URL" to https://your-domain/discord/interactions only after this app
# is deployed and running with these values set - Discord verifies it with a signed PING first.
DISCORD_PUBLIC_KEY=your_application_public_key_here
DISCORD_APPLICATION_ID=your_application_id_here

# Bootstrap admin: set to your Discord user ID to auto-create an admin account on first login.
# Remove or leave blank after initial setup.
BOOTSTRAP_ADMIN_DISCORD_ID=
